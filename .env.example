# Copy this file to .env and fill in real values. .env is gitignored.

# --- Telegram ---
# Bot token from @BotFather (https://t.me/BotFather).
TELEGRAM_BOT_TOKEN=
# Your own Telegram chat id. Message @userinfobot or check the `chat.id`
# field in a getUpdates response after messaging your bot once. Required so
# the bot ignores messages from anyone else who finds its username.
TELEGRAM_ALLOWED_CHAT_ID=

# --- Anki ---
# Absolute path to collection.anki2, e.g.
# /Users/<you>/Library/Application Support/Anki2/User 1/collection.anki2
ANKI_COLLECTION_PATH=
ANKI_DECK_NAME=Vocabulary
ANKI_NOTE_TYPE=Basic
# Seconds to wait for a graceful `quit` before force-killing Anki.app.
ANKI_CLOSE_TIMEOUT_SECONDS=15
# Heuristic window (seconds) to let sync-on-open finish before quitting
# Anki.app again. Raise this if logs show Anki quitting mid-sync.
ANKI_SYNC_WAIT_SECONDS=45

# --- Dictionary lookup ---
DICTIONARY_PRIMARY_URL=https://en.wiktionary.org/api/rest_v1/page/definition/
DICTIONARY_FALLBACK_URL=https://api.dictionaryapi.dev/api/v2/entries/en/
# When true, LLM_API_KEY is required and used as a last-resort definition
# source for words neither dictionary above has. Costs money per call, so
# it stays off unless you turn it on deliberately.
LLM_FALLBACK_ENABLED=false
LLM_API_KEY=

# --- Scheduling ---
# Comma-separated HH:MM (24h, local time) wake/run times, e.g. 08:00,20:00.
# Feeds both `pmset repeat wake` and the generated LaunchAgent plist.
WAKE_TIMES=08:00,20:00

# --- Paths ---
# Absolute path to this project's checkout on the machine that runs it.
PROJECT_DIR=
# Both default to subdirectories of PROJECT_DIR if left blank.
STATE_DIR=
LOG_DIR=
